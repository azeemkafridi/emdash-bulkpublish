{
	"name": "emdash-plugin-bulkpublish",
	"version": "0.1.0",
	"description": "Share EmDash posts to 15 social networks through BulkPublish",
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": { "import": "./dist/index.mjs", "types": "./dist/index.d.mts" },
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": ["dist", "emdash-plugin.jsonc"],
	"keywords": ["emdash", "plugin", "social-media", "scheduling", "bulkpublish"],
	"license": "MIT",
	"peerDependencies": { "emdash": ">=1.0.0" },
	"devDependencies": {
		"@emdash-cms/plugin-cli": "0.13.4",
		"emdash": "1.3.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	},
	"scripts": {
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"validate": "emdash-plugin validate",
		"bundle": "emdash-plugin bundle",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"repository": { "type": "git", "url": "git+https://github.com/bulkpublish/emdash-bulkpublish.git" }
}
